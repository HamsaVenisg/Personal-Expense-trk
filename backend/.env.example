# Get the exact Session pooler URI from Supabase dashboard > Connect.
# Replace HOST, PROJECT_REF and PASSWORD; URL-encode any reserved password characters.
# Only place this full credential in backend/.env (NEVER frontend or Git).
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@HOST.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=120
